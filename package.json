{
  "name": "xingbuild",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "framework:layout": "node scripts/generate-framework-layout.mjs",
    "build": "npm run framework:layout && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "content:import": "node scripts/content-import.mjs",
    "content:check": "node scripts/content-check.mjs",
    "content:preview": "node scripts/content-preview.mjs",
    "content:approve": "node scripts/content-approve.mjs",
    "content:review": "node scripts/content-review.mjs",
    "content:promote": "node scripts/content-promote.mjs",
    "content:supersede": "node scripts/content-supersede.mjs",
    "content:scope-check": "node scripts/content-scope-check.mjs",
    "practice:check": "node scripts/practice-content-check.mjs",
    "release:closeout-check": "node scripts/release-closeout-check.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify": "node scripts/verify-public-release.mjs",
    "release:check": "npm run check && npm run content:check && npm run practice:check && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "12.10.0",
    "elkjs": "0.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "edgeone": "1.6.17"
  }
}
