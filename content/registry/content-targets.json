{
  "registryId": "xingbuild-content-targets",
  "schemaVersion": 1,
  "purpose": "机器可读的内容定位与编辑白名单；不复制正文，不授权产品工程修改。",
  "fieldPathSyntax": "顶层字段使用 field；数组项使用 arrayPath[id=value].field；不使用易变文本或 DOM selector。",
  "independentRelease": true,
  "targets": [
    {
      "targetId": "products.robotaxi.title",
      "scope": "field",
      "kind": "product-content",
      "sourcePath": "content/products/robotaxi.json",
      "fieldPath": "title",
      "projectionRoutes": ["/products"],
      "valueType": "string",
      "editable": true,
      "constraints": {"nonEmpty": true, "maxLength": 80},
      "requires": ["user-confirmation", "robotaxi-fact-boundary"]
