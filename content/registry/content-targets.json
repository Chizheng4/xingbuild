  "templates": [
    {
      "targetIdPattern": "observations.{slug}.title",
      "scope": "field",
      "kind": "observation",
      "sourcePathTemplate": "content/observations/{slug}.json",
      "fieldPath": "title",
      "projectionRoutes": ["/observations/{slug}"],
      "valueType": "string",
      "editable": true,
      "constraints": {"nonEmpty": true},
      "requires": ["user-confirmation", "source-boundary"]
    },
