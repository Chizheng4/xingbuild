  "excluded": [
    {
      "targetId": "home.*",
      "sourcePath": "src/content/siteContent.js",
      "reason": "首页主文案尚未外部化为独立内容对象；内容 task 不得直接修改 src/。"
    },
    {
      "targetId": "*.(route|schema|component|css|interaction|source|mediaApproval)",
      "reason": "属于产品工程、事实来源或媒体审核边界，不是普通内容字段。"
    }
  ]
